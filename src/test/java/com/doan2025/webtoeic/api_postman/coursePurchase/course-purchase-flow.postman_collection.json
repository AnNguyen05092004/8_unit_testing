                {
                    "name": "Pick Purchasable Course",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/v1/course/get-courses?page=0&size=50&sort=createdAt,desc"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.response.to.have.status(200);",
                                    "const json = pm.response.json();",
                                    "const rows = (json.data && json.data.content) || [];",
                                    "const purchasable = rows.find(c => c && c.isBought === false && (!c.statusOrder || c.statusOrder === ''));",
                                    "pm.test('Has at least one purchasable course', function () {",
                                    "  pm.expect(!!purchasable).to.eql(true);",
                                    "});",
                                    "if (purchasable) {",
                                    "  pm.collectionVariables.set('selectedCourseId', String(purchasable.id));",
                                    "  pm.environment.set('selectedCourseId', String(purchasable.id));",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "HELPER - add course to cart for ORDER-CTRL-020",
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/api/v1/cart/add-to-cart?id={{selectedCourseId}}"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.expect(pm.response.code).to.eql(200);"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "HELPER - capture cartItemId for ORDER-CTRL-020",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/api/v1/cart"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.response.to.have.status(200);",
                                    "const json = pm.response.json();",
                                    "const rows = json.data || [];",
                                    "pm.test('Cart has rows', function(){ pm.expect(rows.length).to.be.greaterThan(0); });",
                                    "const row = rows[rows.length - 1];",
                                    "pm.collectionVariables.set('cartItemId', String(row.id));",
                                    "pm.environment.set('cartItemId', String(row.id));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "HELPER - pick another purchasable course for ORDER-CTRL-029",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{}"
                        },
                        "url": "{{baseUrl}}/api/v1/course/get-courses?page=0&size=50&sort=createdAt,desc"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.response.to.have.status(200);",
                                    "const json = pm.response.json();",
                                    "const rows = (json.data && json.data.content) || [];",
                                    "const c1 = pm.collectionVariables.get('selectedCourseId');",
                                    "const another = rows.find(c => c && String(c.id) !== String(c1) && c.isBought === false && (!c.statusOrder || c.statusOrder === ''));",
                                    "pm.test('Found another purchasable course', function () { pm.expect(!!another).to.eql(true); });",
                                    "if (another) {",
                                    "  pm.collectionVariables.set('selectedCourseId2', String(another.id));",
                                    "  pm.environment.set('selectedCourseId2', String(another.id));",
                                    "}"
                                ]
                            }
                        }
                    ]
                }
            ]
