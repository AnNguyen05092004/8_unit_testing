                    "name": "Login Student",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/v1/auth/login"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.response.to.have.status(200);",
                                    "const json = pm.response.json();",
                                    "pm.expect(json.code).to.eql(200);",
                                    "pm.expect(json.data.authenticated).to.eql(true);",
                                    "pm.collectionVariables.set('studentAccessToken', json.data.token);",
                                    "pm.environment.set('studentAccessToken', json.data.token);"
                                ]
                            }
                        }
                    ]
