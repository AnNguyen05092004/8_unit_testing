        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Compute orderCourseId">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">String ids = vars.get(&quot;orderCourseIds&quot;);
String[] arr = ids.split(&quot;;&quot;);
int idx = Math.floorMod(ctx.getThreadNum(), arr.length);
vars.put(&quot;orderCourseId&quot;, arr[idx].trim());</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
