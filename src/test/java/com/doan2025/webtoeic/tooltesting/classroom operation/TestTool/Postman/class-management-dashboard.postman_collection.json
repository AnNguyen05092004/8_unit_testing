{
  "info": {
    "_postman_id": "a7f36458-86ea-43b7-8f83-0fdf8bf10b01",
    "name": "Dashboard Class Management API",
    "description": "API interactions used by dashboard/class-management and class detail tabs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP status is not 5xx', function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});",
          "let body = {};",
          "try { body = pm.response.json(); } catch (e) { body = {}; }",
          "pm.test('Response has standard wrapper (code/message) when JSON', function () {",
          "  if (Object.keys(body).length > 0) {",
          "    pm.expect(body).to.have.property('code');",
          "    pm.expect(body).to.have.property('message');",
          "  }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Login Teacher",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let res = {};",
                  "try { res = pm.response.json(); } catch (e) {}",
                  "if (res && res.data && res.data.token) {",
                  "  pm.environment.set('teacherToken', res.data.token);",
                  "  pm.environment.set('authToken', res.data.token);",
                  "}",
                  "pm.test('Teacher login success', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"{{teacherPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let res = {};",
                  "try { res = pm.response.json(); } catch (e) {}",
                  "if (res && res.data && res.data.token) {",
                  "  pm.environment.set('managerToken', res.data.token);",
                  "}",
                  "pm.test('Manager login success', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{managerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
